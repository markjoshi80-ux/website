{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/robots.txt", "/sitemap.xml", "/*.{css,js,png,svg,ico,webp,jpg,jpeg,xml,txt}"]
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*",
      "headers": {
        "x-content-type-options": "nosniff",
        "x-frame-options": "SAMEORIGIN",
        "referrer-policy": "strict-origin-when-cross-origin"
      }
    }
  ]
}
